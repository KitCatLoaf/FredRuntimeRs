local http = fred.http

function dmsg(channel_id, message, verbose)
    local auth_token = os.getenv("EVE_AUTH_DISCORD")
    if not auth_token then
        print(fred.color("Error: EVE_AUTH_DISCORD environment variable is missing", "red"))
        return nil
    end

    local url = "https://discord.com/api/v9/channels/" .. channel_id .. "/messages"
    local clean_msg = message:gsub('"', '\\"')
    local payload = '{"content": "' .. clean_msg .. '"}'

    local body, status = http.post(url, payload, {
        ["Authorization"] = auth_token,
        ["Content-Type"] = "application/json"
    })

    if verbose then
        -- Matches stdout printing when -o is supplied
        print(body)
    end

    return status == 200 or status == 201
end

local channel = fred.read("CHANNEL ID: ")
local message = fred.read("MESSAGE: ")

dmsg(channel, message, false)